# =============================================================================
# BlackGYM — Environment Variables
# Copy to .env for local. On Vercel: Project → Settings → Environment Variables
# =============================================================================

# MySQL connection string
# Local (MAMP): mysql://root:root@127.0.0.1:8889/blackgym
# Production: use a hosted MySQL (PlanetScale, Railway, Aiven, TiDB, …)
# For serverless, prefer a pooled URL and keep connection_limit low, e.g.:
# DATABASE_URL="mysql://USER:PASS@HOST:3306/DB?connection_limit=1"
DATABASE_URL="mysql://root:root@127.0.0.1:8889/blackgym"

# Auth.js (NextAuth v5) — required in production
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-secret"
# Local only; on Vercel set to your production URL (https://your-app.vercel.app)
AUTH_URL="http://localhost:3000"

# Public site URL (used in emails, payment callbacks, sitemap helpers)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments: mock | zibal | idpay
PAYMENT_PROVIDER="mock"
PAYMENT_MERCHANT_ID=""

# Uploads: local (ephemeral on Vercel — prefer object storage later)
UPLOAD_PROVIDER="local"

# Protects /api/cron/membership-expiry (Vercel Cron sends Authorization: Bearer …)
# Generate: openssl rand -base64 32
CRON_SECRET="generate-a-long-random-cron-secret"
