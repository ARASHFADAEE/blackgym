# =============================================================================
# BlackGYM — Environment Variables
# Local: copy to .env
# Vercel: Project → Settings → Environment Variables (Production + Preview)
# =============================================================================

# PostgreSQL (Vercel Prisma Postgres / Neon / …)
# On Vercel, Prisma integration may also set POSTGRES_URL and PRISMA_DATABASE_URL.
# Prisma Client reads DATABASE_URL — set it to the same Postgres connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional aliases created by Vercel Prisma integration (keep in sync with DATABASE_URL):
# POSTGRES_URL="postgresql://..."
# PRISMA_DATABASE_URL="postgresql://..."

# Auth.js (NextAuth v5) — required in production
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-secret"
# Production example: https://blackgym-rouge.vercel.app
AUTH_URL="http://localhost:3000"

# Public site URL (payment callbacks, absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments: mock | zibal | idpay
PAYMENT_PROVIDER="mock"
PAYMENT_MERCHANT_ID="mock-merchant"

# Uploads: local is ephemeral on Vercel filesystem
UPLOAD_PROVIDER="local"

# Protects /api/cron/membership-expiry (Vercel Cron → Authorization: Bearer …)
# Generate: openssl rand -base64 32
CRON_SECRET="generate-a-long-random-cron-secret"
